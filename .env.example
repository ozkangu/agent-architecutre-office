# Mimari Ofis Simülatörü - Ortam Değişkenleri

# ============= API ANAHTARLARI =============

# OpenRouter API Key (Önerilen - Çoklu model erişimi)
# https://openrouter.ai/keys adresinden alabilirsiniz
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API Key (Alternatif)
# https://platform.openai.com/api-keys adresinden alabilirsiniz
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============= API PROVIDER SEÇİMİ =============

# API Provider: openrouter, openai, azure
API_PROVIDER=openrouter

# ============= PROJE AYARLARI =============

# Varsayılan proje adı
PROJECT_NAME=Yeni_Proje

# Maksimum konuşma turu
MAX_TURNS=20

# Çıktı formatı: markdown, json, txt
OUTPUT_FORMAT=markdown

# Loglama aktif mi?
ENABLE_LOGGING=true

# ============= MODEL AYARLARI =============

# Varsayılan model (OpenRouter için)
DEFAULT_MODEL=anthropic/claude-3.5-sonnet

# Varsayılan temperature
DEFAULT_TEMPERATURE=0.7

# Maksimum token sayısı
MAX_TOKENS=2000

# ============= WEB UI AYARLARI =============

# Web UI portu
UI_PORT=7860

# Web UI host
UI_HOST=0.0.0.0
